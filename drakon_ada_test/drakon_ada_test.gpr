with "config/drakon_ada_test_config.gpr";
project Drakon_Ada_Test is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Drakon_Ada_Test_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("drakon_ada_test.adb");

   package Compiler is
      for Default_Switches ("Ada") use Drakon_Ada_Test_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Drakon_Ada_Test;
